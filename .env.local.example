# Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional server-only secret for a separately verified local/staging backend.
# The draft Storage lifecycle fails closed without a matching project secret.
# Never expose this using NEXT_PUBLIC_ or share Production credentials with Preview.
# SUPABASE_SECRET_KEY=
# Edge Function environment only: exact, comma-separated frontend origins.
# STORAGE_UPLOAD_ORIGINS=http://localhost:3000
